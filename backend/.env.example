# Copy to backend/.env and adjust. Never commit the real .env.
APP_NAME=Smart Traffic Management and Intelligent Transportation System for Lusaka CBD

# Database: SQLite by default (file in data/). For PostgreSQL see docs/DATABASE.md, e.g.
# DATABASE_URL=postgresql+psycopg://traffic:CHANGE_ME@localhost:5432/traffic
RETENTION_DAYS=30
# peak periods 07-09 / 16-19 are local time
TIMEZONE=Africa/Lusaka

# Measurement source: auto | vision | demo   (can also be changed in System Settings)
DATA_SOURCE=auto

# AI detection
VISION_ENABLED=true
# downloaded once into models/
YOLO_MODEL=yolo26n.pt
YOLO_CONF=0.35
YOLO_IMGSZ=640
# YOLO_DEVICE=intel:gpu        # only with an OpenVINO export, see docs/PERFORMANCE in README

TICK_SECONDS=1.0
PERSIST_EVERY_S=5
DEMO_SEED=7
INTERSECTION_ID=INT-001
INTERSECTION_NAME=Demo Intersection — Lusaka
# Login. The first start creates this admin account; without ADMIN_PASSWORD a random password
# is generated and saved to data/admin-credentials.txt. Manage users: python scripts/manage_users.py
ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.org
# ADMIN_PASSWORD=choose-a-long-password
SESSION_HOURS=12
REMEMBER_DAYS=30
# Set true only when the dashboard is served over HTTPS
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
